# AutoService tenant environment variables
# Copy to ${TENANT_DATA_DIR}/.env and fill in values

# Tenant identity
TENANT=demo

# Port offset for multi-tenant isolation (0, 100, 200, ...)
PORT_OFFSET=0

# Computed ports (base + offset)
PORT_OFFSET_9999=9999
PORT_OFFSET_5173=5173
PORT_OFFSET_5174=5174
PORT_OFFSET_5175=5175
DEMO_PORT=8000

# zchat channel-server image
ZCHAT_IMAGE=zchat/channel-server:latest

# Service connectivity
CHANNEL_SERVER_URL=ws://channel-server:9999

# Tenant data directory (host path)
TENANT_DATA_DIR=./data/demo

# REQUIRED - no default
ANTHROPIC_API_KEY=
