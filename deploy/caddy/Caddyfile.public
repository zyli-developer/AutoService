{
    admin off
    auto_https off
    log {
        output file {$AUTOSERVICE_ROOT}/.autoservice/logs/caddy.log {
            roll_size 10mb
            roll_keep 10
        }
        format json
    }
}

http://:{$CADDY_PORT} {
    encode zstd gzip

    @root path /
    redir @root /site/ 302

    handle /robots.txt {
        respond "User-agent: *\nDisallow: /\n" 200
    }

    handle /_caddy_health {
        respond "ok" 200
    }

    redir /site /site/ 308
    handle_path /site/* {
        root * {$AUTOSERVICE_ROOT}/frontend/apps/customer-chat/dist
        try_files {path} /index.html
        file_server
    }

    redir /console /console/ 308
    handle_path /console/* {
        root * {$AUTOSERVICE_ROOT}/frontend/apps/operator-console/dist
        try_files {path} /index.html
        file_server
    }

    redir /admin /admin/ 308
    handle_path /admin/* {
        root * {$AUTOSERVICE_ROOT}/frontend/apps/admin-portal/dist
        try_files {path} /index.html
        file_server
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-Proto https
        }
    }

    handle /ws/* {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-Proto https
        }
    }

    handle {
        respond "not found" 404
    }
}
