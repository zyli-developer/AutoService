# AutoService 本地配置 (复制为 config.local.yaml 使用)
# 此文件被 gitignore，安全存放密钥和本地参数

# ─── 部署模式（M2） ─────────────────────────────────────
# master: 主平台（运维 A 从 admin-portal 创建 tenant）
# tenant: fork 仓（单租户运行时；tenant_id 必填，且与 plugins/<tid>/config.json 一致）
deployment_mode: master        # master | tenant
tenant_id: null                # master 模式 null；tenant 模式必填

# ─── ForkCreator（仅 master 模式消费） ─────────────────
fork_creator: local            # local | github_api（M2 §3.4）

# ─── Dream Agent（M2） ─────────────────────────────────
dream:
  idle_threshold_min: 30       # 最后一次对话超过此分钟 → idle 触发
  cool_down_min: 60            # 单次 run_dream 后的硬冷却（分钟）
  max_tool_turns: 10           # agent loop 工具调用轮数硬上限

# ─── 管理员鉴权（M2 §5） ───────────────────────────────
auth:
  admin_emails: []             # 允许登录 admin-portal 的邮箱列表
  smtp:
    host: ""                   # 空字符串 → 开发模式（log + .eml 落本地）
    port: 587
    user: ""
    password_env: "SMTP_PASSWORD"
    from: "AutoService <noreply@example.com>"

# ─── CC Pool 配置 ───────────────────────────────────────
cc_pool:
  # 池大小
  min_size: 1               # 最小保持的热实例数 (健康检查会自动补充)
  max_size: 4               # 最大并发实例数 (超出时排队等待)
  warmup_count: 1           # 启动时预创建数量

  # 回收策略
  max_queries_per_instance: 50   # 单实例查询上限后回收 (避免上下文膨胀)
  max_lifetime_seconds: 3600     # 单实例最大存活秒数后回收 (1小时)

  # 超时与监控
  health_check_interval: 30      # 健康检查间隔 (秒)
  checkout_timeout: 30           # 池耗尽时最大等待秒数

  # SDK 参数
  permission_mode: bypassPermissions   # default | acceptEdits | plan | bypassPermissions
  # model: claude-sonnet-4-5           # 兜底模型（未配 tier 时用此项；不设则 SDK 默认）
  # cli_path: /usr/local/bin/claude    # 不设置则自动检测 PATH 中的 claude

  # ─── 按角色分配模型（fast / slow / dream tier） ────────
  # 与 autoservice/classify_intent.yaml::model_tiers 协同：
  #   fast_model  → triage / translate           （目标延迟 ~1s）
  #   slow_model  → customer / lead              （目标延迟 5–15s）
  #   dream_model → dream agent loop             （未配则回落到 slow_model 再回落 model）
  # 任意字段未设置时，该 tier 回落到上方 `model`（保持单模型部署的兼容行为）。
  # fast_model: claude-haiku-4-5
  # slow_model: claude-sonnet-4-6
  # dream_model: claude-opus-4-7

  # ─── 预热 tenant 绑定（单热租户部署的首问提速） ────────
  # 设置后：
  #   1) 主池 warmup_count 个实例都以此 tenant 的 soul + KB tool 预创建，
  #      首条客户消息无需走 destroy+rebuild（~3s/新会话）。
  #   2) CCPool.start() 同步预开 (triage, warmup_tenant_id) 子池并预热 1
  #      个实例，首次 triage 分流不撞 2s 超时（~2s/租户首问）。
  # 多租户部署留空（None）→ 沿用惰性创建 + 首用重建的旧行为。
  # warmup_tenant_id: cinnox

# ─── Takeover（接管/释放）配置 ─────────────────────────
# Operator /hijack 后如何自动释放回 AI
takeover:
  idle_timeout_ms: 30000      # /hijack 后静默多久触发自动释放（含 warning 阶段）
  warning_ms: 5000            # 预警阶段长度（warning → release 之间的缓冲）
  offline_grace_ms: 30000     # operator WS 断开多久算真正离线

# ─── 其他配置示例 ───────────────────────────────────────
# api_keys:
#   anthropic: sk-ant-xxx
#
# feishu:
#   app_id: cli_xxx
#   app_secret: xxx
