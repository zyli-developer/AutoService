{
  "name": "@autoservice/operator-console",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "工作台 SPA (内部工作台, Ant Design)",
  "scripts": {
    "dev": "vite --port 5174 --host",
    "build": "tsc --noEmit && vite build",
