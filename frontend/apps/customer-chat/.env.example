# Voice call feature — URL of the cc-openclaw voice-web frontend.
# The customer-chat SPA embeds this URL in an iframe when the user clicks
# the phone FAB. Must be an HTTPS origin (microphone API requires a secure
# context). Falls back to https://voice.ezagent.chat when unset.
VITE_VOICE_WEB_URL=https://voice.ezagent.chat

# Backend WebSocket base URL. If unset, the SPA derives it from window.location
# (same-origin via the dev server proxy or a prod reverse proxy).
# VITE_WS_BASE=wss://chat.example.com
