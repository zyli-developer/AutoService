# Voice gateway WebSocket base URL (native voice, Phase C-D). The SPA opens
# `/asr` and `/tts` WebSockets against this host. `http(s)://` is auto-upgraded
# to `ws(s)://` at runtime. If unset, falls back to same-origin.
VITE_VOICE_GATEWAY_URL=http://localhost:8089

# Backend WebSocket base URL. If unset, the SPA derives it from window.location
# (same-origin via the dev server proxy or a prod reverse proxy).
# VITE_WS_BASE=wss://chat.example.com
