{
  "name": "autoservice-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "AutoService 前端 monorepo (T0.6 骨架)",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "scripts": {
    "dev:customer": "pnpm --filter @autoservice/customer-chat dev",
    "dev:operator": "pnpm --filter @autoservice/operator-console dev",
    "dev:admin": "pnpm --filter @autoservice/admin-portal dev",
    "build:all": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r exec eslint 'src/**/*.{ts,tsx}'",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
